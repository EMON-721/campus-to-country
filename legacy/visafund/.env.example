# Configure through the hosting secure environment interface; no credentials in Git.
AUTH_PROVIDER_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=https://configure-your-origin.invalid
DATA_RETENTION_DAYS=
DATA_RETENTION_POLICY_VERSION=
# Operator-only provisioning variables: set in a separate secret-manager session.
# Never attach SUPABASE_SECRET_KEY to the ordinary application Worker.
# SUPABASE_SECRET_KEY=
# ADMIN_SUBJECT=
# ADMIN_EXPECTED_EMAIL=operator@example.invalid

# Set true ONLY on external Cloudflare deployment; native Sites keeps this unset.
EXTERNAL_HOSTING=false


# External private document adapter only; configure as a Cloudflare encrypted Secret.
# This key is privileged infrastructure access; never expose it to browser code.
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=visafund-documents


# Server environment only; never prefix these with NEXT_PUBLIC_.
CTC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CTC_SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
CTC_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
CTC_STORAGE_BUCKET=ctc-files
TURSO_DATABASE_URL=libsql://YOUR_DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR_DATABASE_TOKEN
# Keep your existing optional Gemini, encryption, payment and email settings.
# CTC_INTEGRATION_ENCRYPTION_KEY=...
